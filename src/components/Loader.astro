<div id="loader" class="fixed inset-0 z-[100] flex items-center justify-center bg-white transition-opacity duration-500">
	<div class="flex flex-col items-center gap-4">
		<div class="loader-spinner"></div>
		<div class="text-blue-600 font-medium text-lg font-['Space_Grotesk']">Chargement...</div>
	</div>
</div>

<script>
	// Masquer le loader après 1-2 secondes
	window.addEventListener('load', () => {
		const loader = document.getElementById('loader');
		if (loader) {
			// Délai aléatoire entre 1 et 2 secondes
			const delay = 1000 + Math.random() * 1000;
			setTimeout(() => {
				loader.style.opacity = '0';
				setTimeout(() => {
					loader.style.display = 'none';
				}, 500); // Attendre la fin de la transition
			}, delay);
		}
	});
</script>

<style>
	.loader-spinner {
		width: 50px;
		height: 50px;
		border: 4px solid rgba(59, 130, 246, 0.2);
		border-top-color: #2563eb;
		border-radius: 50%;
		animation: spin 1s linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	#loader {
		backdrop-filter: blur(10px);
	}
</style>
