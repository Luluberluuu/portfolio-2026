---
interface Props {
	name: string;
	svg: string;
}

const { name, svg } = Astro.props;
---

<div class="flex flex-col items-center p-4 bg-white/60 backdrop-blur-md rounded-xl border border-blue-200/40 hover:bg-white/80 hover:shadow-xl hover:border-blue-300/60 transition-all duration-300 group hover:-translate-y-1">
	<img src={svg} alt={name} class="w-16 h-16 mb-3 flex items-center justify-center group-hover:scale-110 transition-transform duration-300" />
	<span class="text-sm font-medium text-gray-700 group-hover:text-blue-600 transition-colors">
		{name}
	</span>
</div>
