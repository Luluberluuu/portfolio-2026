<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
	<!-- Formes géométriques légères en SVG -->
	<svg class="absolute top-0 left-0 w-full h-full opacity-[0.15]" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
		<!-- Cercles subtils -->
		<circle cx="8%" cy="15%" r="80" fill="none" stroke="rgba(59, 130, 246, 0.25)" stroke-width="0.5" />
		<circle cx="92%" cy="25%" r="120" fill="none" stroke="rgba(6, 182, 212, 0.25)" stroke-width="0.5" />
		<circle cx="45%" cy="85%" r="100" fill="none" stroke="rgba(59, 130, 246, 0.2)" stroke-width="0.5" />
		<circle cx="25%" cy="60%" r="60" fill="none" stroke="rgba(6, 182, 212, 0.2)" stroke-width="0.5" />
		
		<!-- Lignes géométriques -->
		<line x1="0" y1="35%" x2="25%" y2="35%" stroke="rgba(59, 130, 246, 0.12)" stroke-width="0.5" />
		<line x1="75%" y1="55%" x2="100%" y2="55%" stroke="rgba(6, 182, 212, 0.12)" stroke-width="0.5" />
		<line x1="15%" y1="0" x2="15%" y2="25%" stroke="rgba(59, 130, 246, 0.12)" stroke-width="0.5" />
		<line x1="85%" y1="75%" x2="85%" y2="100%" stroke="rgba(6, 182, 212, 0.12)" stroke-width="0.5" />
		<line x1="30%" y1="45%" x2="70%" y2="45%" stroke="rgba(59, 130, 246, 0.1)" stroke-width="0.5" />
		
		<!-- Triangles subtils -->
		<polygon points="150,80 220,180 80,180" fill="none" stroke="rgba(59, 130, 246, 0.15)" stroke-width="0.5" />
		<polygon points="82%,58% 87%,68% 77%,68%" fill="none" stroke="rgba(6, 182, 212, 0.15)" stroke-width="0.5" />
		
		<!-- Rectangles arrondis subtils -->
		<rect x="12%" y="48%" width="180" height="90" rx="15" fill="none" stroke="rgba(59, 130, 246, 0.15)" stroke-width="0.5" />
		<rect x="68%" y="8%" width="140" height="70" rx="12" fill="none" stroke="rgba(6, 182, 212, 0.15)" stroke-width="0.5" />
		<rect x="55%" y="70%" width="120" height="60" rx="10" fill="none" stroke="rgba(59, 130, 246, 0.12)" stroke-width="0.5" />
	</svg>
	
	<!-- Formes géométriques CSS animées très subtiles -->
	<div class="absolute top-16 left-8 w-28 h-28 border border-blue-300/15 rounded-lg rotate-45 animate-geometric-pulse"></div>
	<div class="absolute bottom-32 right-16 w-20 h-20 border border-cyan-300/15 rounded-full animate-geometric-pulse" style="animation-delay: 1.5s;"></div>
	<div class="absolute top-1/2 left-1/5 w-14 h-14 border border-blue-400/15 rotate-12 animate-geometric-pulse" style="animation-delay: 0.8s;"></div>
	<div class="absolute top-3/4 right-1/3 w-18 h-18 border border-cyan-400/15 rounded-lg rotate-45 animate-geometric-pulse" style="animation-delay: 2s;"></div>
</div>

<style>
	@keyframes geometric-pulse {
		0%, 100% {
			opacity: 0.1;
			transform: scale(1);
		}
		50% {
			opacity: 0.2;
			transform: scale(1.05);
		}
	}
	
	.animate-geometric-pulse {
		animation: geometric-pulse 8s ease-in-out infinite;
	}
</style>
