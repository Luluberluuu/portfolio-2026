---
interface Props {
	title: string;
	subtitle?: string;
	period: string;
	description?: string;
	icon?: string;
}

const { title, subtitle, period, description, icon } = Astro.props;
---

<div class="relative pl-8 pb-8 border-l-2 border-blue-200/60 last:border-0 last:pb-0 transition-all duration-300 hover:border-blue-300/80">
	<div class="absolute -left-[9px] top-0 w-4 h-4 bg-linear-to-r from-blue-600 via-cyan-500 to-blue-700 rounded-full border-2 border-white shadow-lg hover:scale-125 transition-transform duration-300"></div>
	<div class="flex items-start gap-4">
		{icon && (
			<div class="w-12 h-12 rounded-lg bg-linear-to-br from-blue-100/80 to-cyan-100/80 backdrop-blur-sm flex items-center justify-center flex-shrink-0 shadow-md hover:shadow-lg transition-shadow duration-300">
				<span class="text-2xl">{icon}</span>
			</div>
		)}
		<div class="flex-1">
			<div class="flex flex-wrap items-baseline gap-2 mb-1">
				<h3 class="text-xl font-semibold text-gray-900">{title}</h3>
				{subtitle && (
					<span class="text-blue-600 font-medium">{subtitle}</span>
				)}
			</div>
			<p class="text-sm text-gray-500 mb-2">{period}</p>
			{description && (
				<p class="text-gray-600 leading-relaxed">{description}</p>
			)}
		</div>
	</div>
</div>
