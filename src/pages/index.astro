		svg: "/icons8-figma.svg"
	},
	{
		name: "Suite Microsoft Office",
		svg: "/icons8-office-365.svg"
	}
];

// Parcours professionnel

// Parcours professionnel
const experiences = [
	{
		title: "Dévelopeur Front-end / Intégrateur web",
		subtitle: "Agence web Marque Digitale",
		period: "2021 - Aujourd'hui",
		description: "Contrat à durée déterminé signé pour 5 mois en tant que Développeur front-end pour les différentes filiales du Groupe Herbarom",
		icon: "👨‍💻"
	},
	{
		title: "Dévelopeur Front-end",
		subtitle: "Herbarom Laboratoire",
		period: "2021",
		description: "Contrat à durée déterminé signé pour 5 mois en tant que Développeur front-end pour les différentes filiales du Groupe Herbarom",
		icon: "💻"
	},
	{
		title: "Assistant Chef de Projet",
		subtitle: "Trigano VDL",
		period: "2019 - 2020",
		description: "Contrat de professionnalisation signé pour 1 an pour mon Bachelor Bac+3 CDA en tant qu'Assistant Chef de Projet",
		icon: "📊"
	},
	{
		title: "Intégrateur web",
		subtitle: "Lycée et Institut Supérieur Saint-Denis",
		period: "2017 - 2019",
		description: "Contrat de professionnalisation signé pour 2 ans pour mon BTS SIO option SLAM",
		icon: "🌐"
	}
];

// Cursus scolaire
const education = [
	{
		title: "Bachelor Bac+3",
		subtitle: "Institut Supérieur Saint-Denis (07)",
		period: "2019 - 2020",
		description: "Bachelor BAC+3 CDA (Concepteur Développeur d’Application) en alternance",
		icon: "🎓"
	},
	{
