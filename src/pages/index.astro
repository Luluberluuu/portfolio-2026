---

<Layout title="Portfolio 2026 - Développeur Web">
	<Loader />
	<DottedBackground />
	<GeometricBackground />
	<Navbar />
	
	<!-- Hero Section -->
	<section id="hero" class="min-h-screen flex items-center justify-center px-4 pt-16 relative overflow-hidden">
		<!-- Animation de gradient animé en fond -->
		<div class="absolute inset-0 animated-gradient"></div>
		
		<!-- Overlay avec blur -->
		<div class="absolute inset-0 bg-white/40 backdrop-blur-md"></div>
		
		<!-- Formes décoratives -->
		<div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(59,130,246,0.15),transparent_50%)]"></div>
		<div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_80%,rgba(6,182,212,0.15),transparent_50%)]"></div>
		
		<ScrollAnimation direction="fade" delay={100}>
			<div class="max-w-6xl mx-auto relative z-10">
				<!-- Badge/Tagline -->
				<div class="flex justify-center mb-6 animate-on-scroll-fade" style="animation-delay: 0.1s;">
					<span class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 backdrop-blur-sm border border-blue-200/50 rounded-full text-sm text-blue-700 font-medium shadow-sm">
						<span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
						Actuellement en recherche d'une nouvelle aventure
					</span>
				</div>
				
				<!-- Titre principal -->
				<h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-4 text-center bg-linear-to-r from-blue-600 via-cyan-500 to-blue-700 bg-clip-text text-transparent font-['Space_Grotesk'] animate-on-scroll-fade">
					Bienvenue, moi c'est
					<br />
					<span class="block mt-2">Luka</span>
				</h1>
				
				<!-- Sous-titre -->
				<p class="text-xl md:text-2xl lg:text-3xl text-gray-700 mb-4 text-center font-medium animate-on-scroll-fade" style="animation-delay: 0.2s;">
					Développeur Frontend / Intégrateur web
				</p>
				
				<!-- Description -->
				<p class="text-base md:text-lg text-gray-600 mb-8 text-center max-w-2xl mx-auto leading-relaxed animate-on-scroll-fade" style="animation-delay: 0.3s;">
					Voici mon nouveau portfolio, vous y trouverez mes projets, mes compétences, mon parcours et mes contacts.
				</p>
				
				<!-- Statistiques/Badges -->
				<div class="flex flex-wrap justify-center gap-6 mb-10 animate-on-scroll-fade" style="animation-delay: 0.4s;">
					<div class="flex flex-col items-center p-4 bg-white/70 backdrop-blur-sm rounded-xl border border-blue-200/50 shadow-sm min-w-[120px]">
						<div class="text-3xl font-bold text-blue-600 font-['Space_Grotesk']">4+</div>
						<div class="text-sm text-gray-600 mt-1">Années d'expérience</div>
					</div>
					<!--<div class="flex flex-col items-center p-4 bg-white/70 backdrop-blur-sm rounded-xl border border-cyan-200/50 shadow-sm min-w-[120px]">
						<div class="text-3xl font-bold text-cyan-600 font-['Space_Grotesk']">20+</div>
						<div class="text-sm text-gray-600 mt-1">Projets réalisés</div>
					</div>
					<div class="flex flex-col items-center p-4 bg-white/70 backdrop-blur-sm rounded-xl border border-blue-200/50 shadow-sm min-w-[120px]">
						<div class="text-3xl font-bold text-blue-600 font-['Space_Grotesk']">100%</div>
						<div class="text-sm text-gray-600 mt-1">Satisfaction client</div>
					</div>-->
				</div>
				
				<!-- Boutons CTA -->
				<div class="flex flex-wrap gap-4 justify-center mb-12 animate-on-scroll-fade" style="animation-delay: 0.5s;">
					<Button href="#projets" variant="primary">
						Voir mes projets
					</Button>
					<Button href="#contact" variant="secondary">
						Me contacter
					</Button>
					<Button href="#a-propos" variant="secondary">
						En savoir plus
					</Button>
				</div>
				
				<!-- Scroll indicator -->
				<div class="flex flex-col items-center animate-bounce" style="animation-delay: 0.6s;">
					<span class="text-sm text-gray-500 mb-2">Découvrir</span>
					<svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
					</svg>
				</div>
			</div>
		</ScrollAnimation>
	</section>

	<!-- À propos Section -->
	<Section id="a-propos" title="À propos" number={1}>
		<div class="grid md:grid-cols-2 gap-6 items-center">
			<ScrollAnimation direction="right" delay={0}>
				<div class="order-2 md:order-1 flex flex-row justify-center">
					<div class="w-64 h-64 mx-auto md:mx-0 rounded-full bg-linear-to-br from-blue-400 via-cyan-400 to-blue-500 p-1 shadow-2xl hover:shadow-blue-500/50 transition-shadow duration-300">
						<div class="w-full h-full rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center text-6xl">
							👨‍💻
						</div>
					</div>
				</div>
			</ScrollAnimation>
			<ScrollAnimation direction="left" delay={100}>
				<div class="order-1 md:order-2">
					<h3 class="text-3xl font-bold mb-6 text-gray-900">
						Qui suis-je ?
					</h3>
					<p class="text-gray-700 mb-4 leading-relaxed text-lg">
						Passionné par l'informatique et les nouvelles technologies, je me spécialise dans la création d'expériences numériques à la croisée du développement et du design.
					</p>
					<p class="text-gray-700 leading-relaxed text-lg mb-4">
						Mon parcours est porté par un intérêt constant pour l'apprentissage de nouveaux langages de développement. 
						Pour moi, concevoir un site ou une application web est un équilibre entre la structure technique et l'esthétique visuelle. 
						Je ne me contente pas de bâtir des outils fonctionnels : je m'attache à soigner leur mise en forme pour offrir la meilleure expérience possible à l'utilisateur.
					</p>
					<p class="text-gray-700 leading-relaxed text-lg">
						Curieux et créatif, je cherche sans cesse à lier mes compétences techniques à ma vision du design pour donner vie à des projets digitaux complets et modernes.
					</p>
				</div>
			</ScrollAnimation>
		</div>
	</Section>

	<!-- Compétences Section -->
	<Section id="competences" title="Compétences" number={2}>
		<ScrollAnimation direction="fade" delay={0}>
			<p class="text-center text-gray-600 mb-12 text-lg max-w-2xl mx-auto">
				Technologies et outils que j'utilise dans les différents projets
			</p>
		</ScrollAnimation>
		<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
			{skills.map((skill, index) => (
				<ScrollAnimation direction="up" delay={index * 50}>
					<SkillIcon name={skill.name} svg={skill.svg} />
				</ScrollAnimation>
			))}
		</div>
	</Section>

	<!-- Parcours Professionnel Section -->
	<Section id="parcours" title="Parcours Professionnel" number={3}>
		<div class="max-w-3xl mx-auto">
			{experiences.map((exp, index) => (
				<ScrollAnimation direction="left" delay={index * 150}>
					<TimelineItem 
						title={exp.title}
						subtitle={exp.subtitle}
						period={exp.period}
						description={exp.description}
						icon={exp.icon}
					/>
				</ScrollAnimation>
			))}
		</div>
	</Section>

	<!-- Cursus Scolaire Section -->
	<Section id="cursus" title="Cursus Scolaire" number={4}>
		<div class="max-w-3xl mx-auto">
			{education.map((edu, index) => (
				<ScrollAnimation direction="right" delay={index * 150}>
					<TimelineItem 
						title={edu.title}
						subtitle={edu.subtitle}
						period={edu.period}
						description={edu.description}
						icon={edu.icon}
					/>
				</ScrollAnimation>
			))}
		</div>
	</Section>

	<!-- Projets Section -->
	<Section id="projets" title="Projets" number={5}>
		<ScrollAnimation direction="fade" delay={0}>
			<p class="text-center text-gray-600 mb-12 text-lg max-w-2xl mx-auto">
				Quelques projets sur lesquels j'ai travaillé, alliant créativité et performance
			</p>
		</ScrollAnimation>
		<div class="grid md:grid-cols-3 gap-6 items-stretch">
			{projects.map((project, index) => (
				<ScrollAnimation direction="up" delay={index * 100}>
					<Card 
						title={project.title}
						description={project.description}
						stack={project.stack}
						href={project.href}
					/>
				</ScrollAnimation>
			))}
		</div>
	</Section>

	<!-- Contact Section -->
	<Section id="contact" title="Contact" number={6}>
		<ScrollAnimation direction="fade" delay={0}>
			<div class="max-w-2xl mx-auto text-center">
				<p class="text-xl text-gray-700 mb-8">
					Intéressé par une collaboration ? N'hésitez pas à me contacter !
				</p>
				<div class="flex flex-wrap gap-4 justify-center">
					<Button href="mailto:parrain.luka@gmail.com" variant="primary">
						📧 Email
					</Button>
					<Button href="https://github.com/Luluberluuu" variant="secondary">
						💻 GitHub
					</Button>
					<Button href="https://www.linkedin.com/in/luka-parrain-477819172/" variant="secondary">
						💼 LinkedIn
					</Button>
				</div>
			</div>
		</ScrollAnimation>
	</Section>

	<!-- Footer -->
	<Footer />
	
	<!-- Popup téléchargement CV -->
	<CVDownloadPopup />
</Layout>

<style>
	/* Styles globaux pour cette page */
	:global(body) {
		background: linear-gradient(to bottom, #eff6ff, #e0f2fe, #dbeafe);
		min-height: 100vh;
	}

	/* Animation pour les éléments au scroll */
	@keyframes float {
		0%, 100% {
			transform: translateY(0px);
		}
		50% {
			transform: translateY(-20px);
		}
	}

	.animate-float {
		animation: float 6s ease-in-out infinite;
	}

	/* Animation de gradient animé */
	.animated-gradient {
		background: linear-gradient(-45deg, #dbeafe, #e0f2fe, #bae6fd, #bfdbfe, #dbeafe);
		background-size: 400% 400%;
		animation: gradient-shift 15s ease infinite;
	}

	@keyframes gradient-shift {
		0% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0% 50%;
		}
	}
</style>
